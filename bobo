<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Эхо в темноте 3D // LIDAR</title>
    <!-- Tailwind CSS через CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Three.js через CDN -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
    <!-- Google Fonts: JetBrains Mono -->
    <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;700;800&display=swap" rel="stylesheet">
    <style>
        * { box-sizing: border-box; user-select: none; -webkit-user-select: none; -webkit-touch-callout: none; touch-action: none; }
        body { margin: 0; padding: 0; background-color: #000000; color: #e0f7fa; font-family: 'JetBrains Mono', monospace; overflow: hidden; width: 100vw; height: 100vh; position: fixed; inset: 0; }
        input[type=range]::-webkit-slider-thumb { -webkit-appearance: none; width: 18px; height: 18px; border-radius: 50%; background: #00f5d4; cursor: pointer; box-shadow: 0 0 10px #00f5d4; }
        
        /* Виньетка опасности */
        #dangerVignette { pointer-events: none; position: absolute; inset: 0; box-shadow: inset 0 0 120px rgba(255, 42, 95, 0); transition: box-shadow 0.4s ease; z-index: 10; }
        
        /* Неоновые эффекты */
        .neon-cyan { text-shadow: 0 0 10px rgba(0, 245, 212, 0.7); }
        .neon-gold { text-shadow: 0 0 10px rgba(255, 209, 102, 0.7); }
        .neon-red { text-shadow: 0 0 10px rgba(255, 42, 95, 0.8); }
        .panel-glass { background: rgba(5, 10, 15, 0.85); backdrop-filter: blur(10px); border: 1px solid rgba(0, 245, 212, 0.25); box-shadow: 0 0 20px rgba(0, 245, 212, 0.1); }

        /* Накладка поворота телефона в портретном режиме */
        #rotateOverlay { display: none; }
        @media screen and (orientation: portrait) {
            #rotateOverlay { display: flex; }
        }
        @keyframes tiltPhone {
            0%, 15% { transform: rotate(0deg); }
            45%, 75% { transform: rotate(-90deg); }
            100% { transform: rotate(0deg); }
        }
        .phone-tilt-anim { animation: tiltPhone 2.6s ease-in-out infinite; }
        
        /* Мобильные кнопки действий */
        .mobile-action-btn { backdrop-filter: blur(8px); transition: transform 0.08s ease, box-shadow 0.12s ease, background-color 0.12s ease; }
        .mobile-action-btn.active-press { transform: scale(0.92); }
    </style>
</head>
<body class="relative w-screen h-screen overflow-hidden select-none bg-black text-teal-100">

