            <!-- Правый верх: 2D мини-радар (без монстров!) -->
            <div class="panel-glass rounded-xl p-2 shadow-lg flex flex-col items-center">
                <canvas id="miniRadarCanvas" width="96" height="96" class="w-20 h-20 sm:w-24 sm:h-24 rounded-lg bg-black/80 border border-teal-500/30"></canvas>
                <span class="text-[8px] text-teal-300/80 font-bold mt-1 tracking-widest">РАДАР 2D</span>
            </div>
