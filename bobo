            <button id="btnRestart" class="w-full py-3.5 bg-teal-500 hover:bg-teal-400 text-black font-extrabold text-sm rounded-xl tracking-widest shadow-[0_0_20px_rgba(0,245,212,0.4)] active:scale-95 transition-all">
