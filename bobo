        <!-- Нижняя подсказка -->
        <div class="flex items-end justify-between w-full pointer-events-none pb-2 sm:pb-0">
            <div id="hudAlertBox" class="panel-glass rounded-xl px-4 py-2 text-[10px] sm:text-xs font-semibold text-teal-300 tracking-wide leading-tight neon-cyan">
                ЛЕВЫЙ СТИК — ШАГ • ПРАВЫЙ ЭКРАН — ОБЗОР • МОНСТРЫ ВИДНЫ ВСЕГДА
