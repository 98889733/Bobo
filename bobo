        <div class="w-20 h-32 border-4 border-teal-400 rounded-xl flex items-center justify-center mb-6 phone-tilt-anim shadow-[0_0_25px_rgba(0,245,212,0.4)]">
            <div class="w-3 h-3 bg-teal-400 rounded-full animate-ping"></div>
        </div>
        <h2 class="text-xl font-bold text-teal-300 neon-cyan mb-2">Поверните телефон горизонтально</h2>
