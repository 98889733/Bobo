            <div id="joystickBase" class="relative w-28 h-28 rounded-full border-2 border-teal-500/30 bg-teal-500/5 backdrop-blur-sm flex items-center justify-center shadow-[0_0_20px_rgba(0,245,212,0.15)]">
                <div id="joystickKnob" class="absolute w-12 h-12 rounded-full bg-teal-400/40 border border-teal-300 shadow-[0_0_15px_#00f5d4] transition-transform duration-75"></div>
                <span id="joystickModeTag" class="absolute -bottom-6 text-[9px] font-extrabold text-teal-200 tracking-wider">ШАГ</span>
            </div>
        </div>

        <!-- Правая зона: обзор свайпом и кнопки -->
        <div id="touchLookZone" class="absolute right-0 bottom-0 w-1/2 h-2/3 pointer-events-auto"></div>

        <!-- Кнопки действий под правый палец -->
        <div class="absolute right-4 bottom-6 z-30 flex flex-col gap-2.5 items-end pointer-events-auto">
            <div class="flex gap-2.5">
                <button id="btnTouchScan" class="mobile-action-btn w-20 h-14 sm:w-24 sm:h-16 rounded-xl bg-cyan-600/40 border border-cyan-400/60 text-cyan-200 font-extrabold text-[10px] sm:text-xs flex flex-col items-center justify-center shadow-[0_0_15px_rgba(0,245,212,0.3)]">
                    <span>SCANN</span>
                    <span class="text-[8px] font-normal opacity-85">Инфракрас [R]</span>
                </button>
                <button id="btnTouchPulse" class="mobile-action-btn w-20 h-14 sm:w-24 sm:h-16 rounded-xl bg-indigo-600/40 border border-indigo-400/60 text-indigo-200 font-extrabold text-[10px] sm:text-xs flex flex-col items-center justify-center shadow-[0_0_15px_rgba(99,102,241,0.3)]">
                    <span>PULSE</span>
                    <span class="text-[8px] font-normal opacity-85">Взрыв [F]</span>
                </button>
            </div>
            <div class="flex gap-2.5">
                <button id="btnTouchSonar" class="mobile-action-btn w-20 h-14 sm:w-24 sm:h-16 rounded-xl bg-amber-500/30 border border-amber-400/60 text-amber-200 font-extrabold text-[10px] sm:text-xs flex flex-col items-center justify-center shadow-[0_0_15px_rgba(255,209,102,0.3)]">
                    <span>СОНАР</span>
                    <span class="text-[8px] font-normal opacity-85">360° Импульс</span>
                </button>
                <button id="btnTouchLidar" class="mobile-action-btn w-24 h-14 sm:w-28 sm:h-16 rounded-xl bg-teal-500/30 border border-teal-400/70 text-teal-200 font-extrabold text-[10px] sm:text-xs flex flex-col items-center justify-center shadow-[0_0_20px_rgba(0,245,212,0.4)]">
                    <span>LIDAR</span>
                    <span class="text-[8px] font-normal opacity-85">Удерживать</span>
                </button>
            </div>
        </div>
    </div>

    <!-- 8. Контейнер для 3D сцены Three.js -->
    <div id="threeContainer" class="absolute inset-0 z-0"></div>

    <!-- 9. Логика звука и игры -->
    <script>
        /** Процедурный звуковой движок на Web Audio API */
        class LidarAudioEngine {
            constructor() {
                this.ctx = null;
                this.masterGain = null;
            }
            init() {
                if (this.ctx) return;
                const AudioCtx = window.AudioContext || window.webkitAudioContext;
                this.ctx = new AudioCtx();
                this.masterGain = this.ctx.createGain();
                this.masterGain.gain.value = 0.35;
                this.masterGain.connect(this.ctx.destination);
            }
            playLidarSweepTick(dt) {
                if (!this.ctx) return;
                const osc = this.ctx.createOscillator();
                const gain = this.ctx.createGain();
                osc.type = 'sawtooth';
                osc.frequency.setValueAtTime(800 + Math.random() * 400, this.ctx.currentTime);
                gain.gain.setValueAtTime(0.015, this.ctx.currentTime);
                gain.gain.exponentialRampToValueAtTime(0.0001, this.ctx.currentTime + 0.04);
                osc.connect(gain);
                gain.connect(this.masterGain);
                osc.start();
                osc.stop(this.ctx.currentTime + 0.04);
            }
            playSonarPulse() {
                if (!this.ctx) return;
                const osc = this.ctx.createOscillator();
                const gain = this.ctx.createGain();
                osc.type = 'sine';
                osc.frequency.setValueAtTime(320, this.ctx.currentTime);
                osc.frequency.exponentialRampToValueAtTime(90, this.ctx.currentTime + 0.5);
                gain.gain.setValueAtTime(0.2, this.ctx.currentTime);
                gain.gain.exponentialRampToValueAtTime(0.001, this.ctx.currentTime + 0.5);
                osc.connect(gain);
                gain.connect(this.masterGain);
                osc.start();
                osc.stop(this.ctx.currentTime + 0.5);
            }
            playQuantumPulse() {
                if (!this.ctx) return;
                const osc = this.ctx.createOscillator();
                const gain = this.ctx.createGain();
                osc.type = 'triangle';
                osc.frequency.setValueAtTime(1200, this.ctx.currentTime);
                osc.frequency.exponentialRampToValueAtTime(150, this.ctx.currentTime + 0.8);
                gain.gain.setValueAtTime(0.3, this.ctx.currentTime);
                gain.gain.exponentialRampToValueAtTime(0.001, this.ctx.currentTime + 0.8);
                osc.connect(gain);
                gain.connect(this.masterGain);
                osc.start();
                osc.stop(this.ctx.currentTime + 0.8);
            }
            playBeaconCollect() {
                if (!this.ctx) return;
                const now = this.ctx.currentTime;
                [523.25, 659.25, 783.99, 1046.5].forEach((freq, i) => {
                    const osc = this.ctx.createOscillator();
                    const gain = this.ctx.createGain();
                    osc.type = 'sine';
                    osc.frequency.setValueAtTime(freq, now + i * 0.08);
                    gain.gain.setValueAtTime(0.15, now + i * 0.08);
                    gain.gain.exponentialRampToValueAtTime(0.001, now + i * 0.08 + 0.3);
                    osc.connect(gain);
                    gain.connect(this.masterGain);
                    osc.start(now + i * 0.08);
                    osc.stop(now + i * 0.08 + 0.3);
                });
            }
            playGameOver() {
                if (!this.ctx) return;
                const now = this.ctx.currentTime;
                const osc = this.ctx.createOscillator();
                const gain = this.ctx.createGain();
                osc.type = 'sawtooth';
                osc.frequency.setValueAtTime(150, now);
                osc.frequency.linearRampToValueAtTime(40, now + 1.2);
                gain.gain.setValueAtTime(0.35, now);
                gain.gain.exponentialRampToValueAtTime(0.001, now + 1.2);
                osc.connect(gain);
                gain.connect(this.masterGain);
                osc.start(now);
                osc.stop(now + 1.2);
            }
        }

        /** Главный класс 3D-игры */
        class EchoLidar3DGame {
            constructor() {
                this.container = document.getElementById('threeContainer');
                this.audio = new LidarAudioEngine();
                this.state = 'MENU';
                this.isLocked = false;
                this.mouseSensitivity = 1.1;
                this.startTime = 0;
                this.elapsedTime = 0;

                this.gridCols = 13;
                this.gridRows = 13;
                this.cellSize = 6.0;
                this.wallHeight = 4.2;

                this.player = {
                    pos: new THREE.Vector3(3, 1.7, 3),
                    yaw: 0,
                    pitch: 0,
                    radius: 0.65,
                    energy: 100,
                    maxEnergy: 100,
                    footstepTimer: 0
                };

                this.keys = {};
                this.isLidarSweeping = false;
                this.isInfraScanning = false; // Режим SCANN

                this.touchMoveId = null;
                this.touchMoveOrigin = { x: 0, y: 0 };
                this.touchMoveVec = { x: 0, y: 0 };
                this.touchLookId = null;
                this.touchLookLast = { x: 0, y: 0 };

                this.maxPoints = 120000;
                this.pointCount = 0;
                this.pointWriteIndex = 0;

                this.colliders = [];
                this.scanMeshes = [];
                this.beacons = [];
                this.predators = [];
                this.exitPortal = null;

                this.radarCanvas = document.getElementById('miniRadarCanvas');
                this.radarCtx = this.radarCanvas.getContext('2d');

                this.initThree();
                this.initPersistentPointCloud();
                this.bindEvents();
                this.lastTime = performance.now();
                requestAnimationFrame((t) => this.animate(t));
            }

            initThree() {
     
