        </div>
    </div>

    <!-- 6. Перекрестие прицела -->
    <div id="crosshair" class="absolute inset-0 z-20 pointer-events-none hidden flex items-center justify-center">
        <div class="w-1.5 h-1.5 bg-teal-400 rounded-full shadow-[0_0_8px_#00f5d4]"></div>
    </div>

    <!-- 7. Мобильные элементы управления (Джойстик и Кнопки) -->
    <div id="touchZones" class="absolute inset-0 z-20 hidden pointer-events-none select-none">
        <!-- Левая зона: виртуальный джойстик движения -->
