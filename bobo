            </div>

            <!-- Центр: Статус опасности -->
            <div class="flex flex-col items-center gap-1">
                <div id="hudThreatLabel" class="panel-glass rounded-lg px-3 py-1.5 text-[10px] sm:text-xs text-teal-300 font-bold tracking-wider uppercase truncate max-w-[220px] sm:max-w-xs text-center shadow-lg">
                    ФОН: НОРМА
