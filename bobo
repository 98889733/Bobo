        <button id="btnDismissRotate" class="px-6 py-2.5 bg-teal-500/20 border border-teal-400/50 rounded-xl text-teal-300 text-xs font-bold active:scale-95 transition-all">Продолжить так</button>
    </div>

    <!-- 2. Стартовое меню -->
    <div id="startModal" class="fixed inset-0 z-50 bg-black/95 flex flex-col items-center justify-center p-6 text-center">
